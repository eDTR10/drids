# Copy this file to .env and fill in your own values. .env is gitignored;
# .env.production (committed) always wins for `npm run build`/`npm run deploy`,
# so your local settings here can never leak into the live site.

# Backend API used by `npm run dev`. Point this at your machine's LAN IP
# running the eTM/DTMS/EFAS Django server, or leave unset to use the
# production API (https://api.yt-jam.com).
VITE_BACKEND_URL=http://192.168.1.54:8000

# Optional local-only admin unlock. If set, typing this value into the Access
# Code dialog unlocks admin mode without calling the backend — handy when the
# admin account doesn't exist yet in your local database. Only works in
# `npm run dev`; it is compiled out of production builds entirely and is
# never shipped to the public site.
VITE_PASSWORD=
